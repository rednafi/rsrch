---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}
// Sections and their direct subsections are enough to navigate a long doc.
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 1 && (
    <nav class="toc" aria-label="On this page">
      <details>
        <summary>On this page</summary>
        <ol>
          {headings.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  // Open on wide screens, where the TOC is a sidebar. On phones it starts closed above the article.
  const wide = matchMedia("(min-width: 1100px)");
  const toc = document.querySelector<HTMLDetailsElement>(".toc details");
  if (toc) toc.open = wide.matches;
  wide.addEventListener("change", (event) => toc && (toc.open = event.matches));
</script>
